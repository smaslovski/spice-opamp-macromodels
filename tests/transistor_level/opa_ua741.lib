Q15 17 23 22 26 QN741
Q21 20 21 22 26 QP741
Q22 8 20 26 26 QN741
Q24 20 20 26 26 QN741
R11 20 26 50k
* bias
Q10 3 5 24 26 QN741
Q11 5 5 26 26 QN741
Q12 6 6 25 26 QP741
R4 24 26 5k
R5 6 5 39k
.model QN741 NPN (BF=200 BR=2.0 VAF=125 IS=10f TF=0.35n RB=200 RC=200 RE=2 CJE=1.0p
+ VJE=0.70 MJE=0.33 CJC=0.3p VJC=0.55 MJC=0.5 CJS=3.0p VJS=0.52 MJS=0.5)
.model QP741 PNP (BF=50 BR=4.0 VAF=50 IS=10f TF=30n RB=300 RC=100 RE=10 CJE=0.3p
+ VJE=0.55 MJE=0.5 CJC=1.0p VJC=0.55 MJC=0.5 CJS=3.0p VJS=0.52 MJS=0.5)
